# ── Groww API Configuration ──
# Get both from https://groww.in/trade-api/api-keys
# API Key (long JWT token)
GROWW_API_TOKEN=eyJraWQiOiJaTUtjVXciLCJhbGciOiJFUzI1NiJ9..PdRHJAc-TOJOgn1KDMk2DYPM5alJSVx1QwItJw6uU44BOpLcCRyl89TSH2Nqn8N1FkEnHBZsUpjKq3hKGrU0sQ

# API Secret (shown alongside the API key on the Groww dashboard)
GROWW_API_SECRET=9fBeqSI_kt)MyOSQDjbkfh@CxCTKs5f(

# ── Application Mode ──
# live   = Execute real orders on Groww
# paper  = Simulate trades without real money
# backtest = Replay historical messages and simulate
MODE=backtest   


# ── Trading Configuration ──
# Number of lots to trade per signal (multiplied by instrument lot size)
DEFAULT_LOT_MULTIPLIER=1

# Maximum risk per trade in INR (order will be skipped if potential loss exceeds this)
MAX_RISK_PER_TRADE=5000

# Product type: NRML (overnight/positional) or MIS (intraday, squared off by EOD)
DEFAULT_PRODUCT=NRML

# Order type for ENTRY: LIMIT (at signal price) or MARKET (at current price)
# MARKET is safer — by the time the signal arrives, price may have moved
ENTRY_ORDER_TYPE=MARKET

# Order type for EXIT: LIMIT (at signal price) or MARKET (at current price)
# MARKET ensures you exit immediately; LIMIT may not fill if price moves away
EXIT_ORDER_TYPE=MARKET

# ── Database ──
DATABASE_PATH=data/automa.db

# ── Logging ──
LOG_LEVEL=INFO
